# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Film master (38 MB, with audio). Kept locally as the source for
# public/film/arc-f1.mp4 — too large for git and must never ship
# (Cloudflare Workers rejects any asset over 25 MiB).
docs/references/source/*.mp4

# Cloudflare / OpenNext build output and local state
.open-next
.wrangler
.dev.vars*
!.dev.vars.example
